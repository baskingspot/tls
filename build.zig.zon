.{
    .name = .tls,
    .version = "0.0.0",
    .fingerprint = 0xacfd1db3288cfd9d,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Production: fixed-capacity containers and memory scans shared with
        // the rest of the baskingspot tree. Not lazy — the library imports it.
        .stdx = .{
            .url = "git+https://github.com/baskingspot/stdx#202b083285edda8c762dffa49ceef61864a3ccab",
            .hash = "stdx-0.0.0-CcWeglgxCgA72RJ7qGvVteltv4cq-3URK-psReTXFdKi",
        },
        // Development-only: the test runner, benchmarks, and comptime txtar
        // fixtures. Lazy so consumers of the library never fetch it.
        .testingx = .{
            .url = "git+https://github.com/baskingspot/testingx#e96eb61de42250a5be03e631b835b3d9f23c8310",
            .hash = "testingx-0.1.1-ib95-6ivAgB3rCWLHww0C7edG1NLC71y1p1wogPV0Djf",
            .lazy = true,
        },
        // Integration-only: fetched when a consumer opts into tls_xev.
        // Keep this pin in sync with integrations/tls-xev/build.zig.zon.
        .libxev = .{
            .url = "git+https://github.com/mitchellh/libxev#7497c85dfc3ae5141308944f2cd47c836772c300",
            .hash = "libxev-0.0.0-86vtc6BWFAAs_tGsasNfjQsxSsElhddIUnqVwGhwdnsu",
            .lazy = true,
        },
    },
    .paths = .{
        "LICENSE",
        "LICENSE-ZIG",
        "build.zig",
        "build.zig.zon",
        "src",
        "tests/fixtures",
        "integrations/tls-std/src",
        "integrations/tls-xev/src",
        "integrations/tls-ktls/src",
    },
}
