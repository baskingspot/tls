.{
    .name = .tls,
    .version = "0.4.5",
    .fingerprint = 0xacfd1db3288cfd9d,
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        // Production: fixed-capacity containers and memory scans shared with
        // the rest of the baskingspot tree. Not lazy — the library imports it.
        .stdx = .{
            .url = "https://baskingspot.dev/stdx/v0.6.0.tar.gz",
            .hash = "stdx-0.6.0-CcWegpsXEQBPvqhuSRRDiRjq08s5gXavvTuvoL-Bo3BE",
        },
        // Development-only: the test runner, benchmarks, and comptime txtar
        // fixtures. Lazy so consumers of the library never fetch it.
        .testingx = .{
            .url = "https://baskingspot.dev/testingx/v0.6.0.tar.gz",
            .hash = "testingx-0.6.0-ib95-yaGAwC1_nvSTOk8ktbCgVfBtDAVTCjNKgXRxBeo",
            .lazy = true,
        },
    },
    .paths = .{
        "LICENSE",
        "LICENSE-ZIG",
        "build.zig",
        "build.zig.zon",
        "src",
        "tests/fixtures",
        "integrations/tls-nonblocking/src",
        "integrations/tls-std/src",
        "integrations/tls-ktls/src",
    },
}
