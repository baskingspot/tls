#!/usr/bin/env bash
# The gate before a push. `just ci` is the whole thing; a commit hook that runs
# lint is not enough, because lint is a subset and the conformance subproject is
# no subset of anything else.
set -euo pipefail

# Detach stdin from git's pipe. The hook does not read the ref list, and a
# downstream child that inherits a descriptor git has closed takes SIGPIPE - the
# exit 141 that looks like the gate failing when the gate passed.
exec </dev/null

if ! command -v just >/dev/null 2>&1; then
    echo "pre-push: just is not on PATH; run inside the devshell" >&2
    exit 1
fi

# The gate writes to a file, not to git's pipes: a child that inherits one of
# them and writes after git closes it dies of SIGPIPE, and the push fails with
# exit 141 even though the gate passed.
log="$(mktemp)"
trap 'rm -f "$log"' EXIT
echo "pre-push: running just ci (the full gate)" >&2
if ! just ci >"$log" 2>&1; then
    echo "pre-push: just ci failed; push refused. Last lines:" >&2
    tail -40 "$log" >&2
    exit 1
fi
echo "pre-push: just ci passed" >&2
