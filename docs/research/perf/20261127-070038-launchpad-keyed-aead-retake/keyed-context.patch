+// RFC 8446 §5.2 — one keyed context authenticates records of different lengths.
+test "AES-256-GCM: cached GHASH powers cover changing record lengths" {
+    const Reference = crypto.aead.aes_gcm.Aes256Gcm;
+    const key: [32]u8 = @splat(0xab);
+    const nonce: [12]u8 = @splat(0xcd);
+    const plaintext: [6144]u8 = @splat(0x42);
+    var ctx: Aes256Gcm = .init(key);
+    var ciphertext: [plaintext.len]u8 = undefined;
+    var expected: [plaintext.len]u8 = undefined;
+    var decrypted: [plaintext.len]u8 = undefined;
+
+    inline for ([_]usize{ 4096, 6144 }) |len| {
+        var tag: [16]u8 = undefined;
+        var expected_tag: [16]u8 = undefined;
+        ctx.encrypt(ciphertext[0..len], &tag, plaintext[0..len], "header", nonce);
+        Reference.encrypt(expected[0..len], &expected_tag, plaintext[0..len], "header", nonce, key);
+        try std.testing.expectEqualSlices(u8, expected[0..len], ciphertext[0..len]);
+        try std.testing.expectEqualSlices(u8, &expected_tag, &tag);
+
+        try ctx.decrypt(decrypted[0..len], ciphertext[0..len], tag, "header", nonce);
+        try std.testing.expectEqualSlices(u8, plaintext[0..len], decrypted[0..len]);
+    }
+}
+
 const Ghash = crypto.onetimeauth.Ghash;
 const modes = crypto.core.modes;
