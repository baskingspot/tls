.{
    .name = .tls_std,
    .version = "0.0.0",
    .fingerprint = 0x805aae3645e451b5, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // In-tree development dependency. External consumers fetch the root
        // package and import its `tls_std` module; see #79.
        .tls = .{
            .path = "../..",
        },
        // Example-only. zio is a stackful-coroutine runtime that implements
        // `std.Io`, which is the interface tls-std already targets — so it needs
        // no adapter and gets no package of its own, just
        // `examples/zio_client.zig` proving the integration. Lazy so a consumer
        // of tls-std never fetches an I/O runtime it did not ask for.
        .zio = .{
            // v0.19.1 is the first tagged release past the old commit pin. It
            // carries zio #735, which drops the reserved AArch64 FFR clobber
            // that made Zig report a successful build as a failure (#104).
            .url = "git+https://github.com/lalinsky/zio?ref=v0.19.1#4daa0c0a9522a37c4d28e3dcec2515cc955abe71",
            .hash = "zio-0.19.1-xHbVVJXzKwAKLRAABWeDvQG9Dg1kf9FM3haWG0YqtScn",
            .lazy = true,
        },
        // Test-only: plain-text test runner. Lazy so consumers never fetch it.
        // Development-only: test runner and comptime fixtures. Lazy so
        // consumers of this package never fetch it.
        .testingx = .{
            .url = "git+https://github.com/baskingspot/testingx#e96eb61de42250a5be03e631b835b3d9f23c8310",
            .hash = "testingx-0.1.1-ib95-6ivAgB3rCWLHww0C7edG1NLC71y1p1wogPV0Djf",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "examples",
        "README.md",
    },
}
