.{
    .name = .tls_xev,
    .version = "0.0.0",
    .fingerprint = 0x2c6f138f2e6d8108, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // In-tree development dependency. External consumers fetch the root
        // package and opt into its `tls_xev` module; see #79.
        .tls = .{
            .path = "../..",
        },
        // libxev is the point of this integration, not an optional extra, so
        // it is a normal (non-lazy) dependency, unlike zio in tls-std.
        .libxev = .{
            .url = "git+https://github.com/mitchellh/libxev#7497c85dfc3ae5141308944f2cd47c836772c300",
            .hash = "libxev-0.0.0-86vtc6BWFAAs_tGsasNfjQsxSsElhddIUnqVwGhwdnsu",
        },
        // Test-only: plain-text test runner. Lazy so consumers never fetch it.
        // Development-only: test runner and comptime fixtures. Lazy so
        // consumers of this package never fetch it.
        .testingx = .{
            .url = "git+https://github.com/baskingspot/testingx#c9b81a4bbf8a41f1317dc0f158ba851cebdae491",
            .hash = "testingx-0.0.0-ib95-4WvAgDlIY73PBF6aDm9FBntyPof0zrluXvyz-v5",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "examples",
        "README.md",
    },
}
