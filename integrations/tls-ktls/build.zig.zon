.{
    .name = .tls_ktls,
    .version = "0.0.0",
    .fingerprint = 0x8940f5449c710ce2,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // In-tree development dependency. External consumers fetch the root
        // package and import its Linux-only `tls_ktls` module; see #79.
        .tls = .{
            .path = "../..",
        },
        // Development-only: test runner and comptime fixtures. Lazy so
        // consumers of this package never fetch it.
        .testingx = .{
            .url = "git+https://github.com/baskingspot/testingx#e96eb61de42250a5be03e631b835b3d9f23c8310",
            .hash = "testingx-0.1.1-ib95-6ivAgB3rCWLHww0C7edG1NLC71y1p1wogPV0Djf",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "examples",
        "README.md",
    },
}
