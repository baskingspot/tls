.{
    .name = .ztls_ktls,
    .version = "0.0.0",
    .fingerprint = 0x6fe677c8d1847ac4,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // In-tree development dependency. External consumers fetch the root
        // package and import its Linux-only `ztls_ktls` module; see #79.
        .ztls = .{
            .path = "../..",
        },
        // Development-only: test runner and comptime fixtures. Lazy so
        // consumers of this package never fetch it.
        .testingx = .{
            .url = "git+https://github.com/baskingspot/testingx#dc6d091cb06600f240077cfc44692e34bf8cd70d",
            .hash = "testingx-0.0.0-ib95-_CrAgCK_MU4VgB2XPTxDFma9rfbcoTGbw0SiZJU",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "examples",
        "README.md",
    },
}
